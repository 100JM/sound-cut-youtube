{
  "name": "cut-youtube",
  "version": "1.2.0",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "Soundcut desktop audio clipper",
  "author": "Soundcut",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.cjs",
    "desktop:start": "electron .",
    "desktop:build": "npm run desktop:prepare && node scripts/build-desktop.cjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/input.test.ts tests/origin.test.ts tests/process.test.ts tests/cancel.test.ts tests/updates.test.cjs",
    "setup:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-tools.ps1"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4",
    "typescript": "^5"
  }
}
